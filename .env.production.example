# Plantilla de producción (cPanel + MySQL) — ver docs/despliegue-cpanel.md.
#
# En el servidor: `cp .env.production.example .env`, edita las 4 líneas
# marcadas con "<- CAMBIAR" con tus datos reales, y corre
# `php artisan key:generate` (llena APP_KEY automáticamente).
#
# `.env.example` (sin ".production") sigue siendo la plantilla de
# desarrollo local (SQLite, APP_DEBUG=true) — no se tocó, `composer install`
# la sigue usando para crear el `.env` local de cualquier clon nuevo.

APP_NAME="Cappi Xtremo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cappixtremo.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# error en vez de debug: en producción no queremos que cada warning/notice
# rutinario infle storage/logs/laravel.log sin límite.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuusuario_cappi
# <- CAMBIAR: nombre de BD que anotaste en el paso 0.6 (con el prefijo que
# le puso cPanel, ej. "tuusuario_cappi").
DB_USERNAME=tuusuario_cappiuser
# <- CAMBIAR: usuario de BD del paso 0.6 (también con prefijo).
DB_PASSWORD=
# <- CAMBIAR: password del usuario de BD del paso 0.6.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, no database: shared hosting no permite un worker de cola persistente
# (`php artisan queue:work`), así que los jobs corren en la misma petición.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# No hay canal de notificaciones transaccionales todavía (gap documentado en
# api/docs/backoffice/05-operacion-financiera.md). Si en el futuro se agrega
# envío de correos reales, reemplazar este bloque por las credenciales SMTP
# reales; mientras tanto "log" no falla, solo escribe el correo al log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@cappixtremo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
